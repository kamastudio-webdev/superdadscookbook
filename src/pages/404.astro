---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page isn’t in the cookbook.">
  <div class="wrap">
    <header class="page-head">
      <h1>That page isn’t in the cookbook</h1>
      <p>The link may be old or mistyped. Find a recipe from the full list or head back to the home page.</p>
    </header>
    <div class="hero-actions">
      <a class="button" href="/recipes/">Browse all recipes</a>
      <a class="button secondary" href="/">Go to the home page</a>
    </div>
  </div>
</Base>
