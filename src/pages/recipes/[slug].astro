---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import { CATEGORY_COLORS } from '../../lib/categories';
import {
  absolutePhoto,
  categoryPath,
  creditLink,
  flatIngredients,
  formatMinutes,
  getRecipes,
  groupIngredients,
  isoDuration,
  photo,
  photoSrcset,
  recipePath,
  servingsNumber,
  totalMinutes,
  UNSPLASH_HOME,
  type Recipe,
} from '../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe) => {
    const sameMeal = recipes.filter((o) => o.id !== recipe.id && o.data.category === recipe.data.category);
    const others = recipes.filter((o) => o.id !== recipe.id && o.data.category !== recipe.data.category);
    return {
      params: { slug: recipe.id },
      props: { recipe, related: [...sameMeal, ...others].slice(0, 3) },
    };
  });
}

interface Props {
  recipe: Recipe;
  related: Recipe[];
}

const { recipe, related } = Astro.props;
const d = recipe.data;
const { Content } = await render(recipe);
const hasStory = Boolean(recipe.body?.trim());
const total = totalMinutes(recipe);
const url = new URL(Astro.url.pathname, Astro.site);
const site = Astro.site;
const servings = servingsNumber(recipe);
const isUnsplash = d.image?.startsWith('https://images.unsplash.com/') ?? false;

/** A name for a step, for Google: its first sentence (shortened only if very long). */
function stepName(text: string): string {
  const s = text.split(/(?<=[.!?])\s/)[0].replace(/[.!?]$/, '');
  return s.length <= 100 ? s : s.slice(0, 100).replace(/\s+\S*$/, '') + '…';
}

// Structured data so Google can show this as a recipe result.
// Google asks for the photo in square, 4:3 and 16:9 shapes.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  url: url.href,
  datePublished: d.date.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: 'Super Dad’s Cookbook' },
  ...(d.image
    ? {
        image: [
          absolutePhoto(d.image, site, 1200, 1200),
          absolutePhoto(d.image, site, 1200, 900),
          absolutePhoto(d.image, site, 1200, 675),
        ],
      }
    : {}),
  recipeCategory: d.category,
  recipeCuisine: d.cuisine,
  recipeYield: servings ? [String(servings), d.servings] : d.servings,
  prepTime: isoDuration(d.prepMinutes),
  cookTime: isoDuration(d.cookMinutes),
  totalTime: isoDuration(total),
  keywords: d.tags.join(', '),
  recipeIngredient: flatIngredients(d.ingredients),
  recipeInstructions: d.steps.map((text, i) => ({
    '@type': 'HowToStep',
    name: stepName(text),
    text,
    url: `${url.href}#step-${i + 1}`,
  })),
  ...(d.adaptedFrom ? { isBasedOn: d.adaptedFrom.url } : {}),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Recipes', item: new URL('/recipes/', site).href },
    { '@type': 'ListItem', position: 2, name: d.category, item: new URL(categoryPath(d.category), site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: new URL(recipePath(recipe), site).href },
  ],
};
---

<Base
  title={d.title}
  description={d.description}
  ogType="article"
  image={d.image ? absolutePhoto(d.image, site, 1200, 630) : undefined}
  imageAlt={d.imageAlt}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbs)} />

  <article class="wrap" style={`--meal-color: ${CATEGORY_COLORS[d.category]}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/recipes/">Recipes</a></li>
        <li><a href={categoryPath(d.category)}>{d.category}</a></li>
      </ol>
    </nav>

    <header class="recipe-head">
      <h1>{d.title}</h1>
      <p class="recipe-lede">{d.description}</p>

      <dl class={d.restMinutes ? "stat-strip has-rest" : "stat-strip"}>
        <div><dt>Prep</dt><dd>{formatMinutes(d.prepMinutes)}</dd></div>
        <div><dt>Cook</dt><dd>{formatMinutes(d.cookMinutes)}</dd></div>
        {d.restMinutes > 0 && <div><dt>{d.restLabel}</dt><dd>{formatMinutes(d.restMinutes)}</dd></div>}
        <div><dt>Total</dt><dd>{formatMinutes(total)}</dd></div>
        <div>
          <dt>Makes</dt>
          <dd><span data-makes>{d.servings}</span><span class="makes-batch" data-makes-batch hidden></span></dd>
        </div>
      </dl>

      <div class="recipe-tools">
        <button class="button" type="button" data-print>Print recipe</button>
        <button class="button secondary" type="button" data-wake aria-pressed="false" hidden>
          Keep screen on while cooking
        </button>
        <p class="tool-note" data-wake-note hidden>Your screen will stay on while this page is open.</p>
      </div>
    </header>

    {
      d.image && (
        <figure class="recipe-figure">
          <img
            class="recipe-photo"
            src={photo(d.image, 1600, 800)}
            srcset={photoSrcset(d.image, 2, [800, 1200, 1600, 2200])}
            sizes="(max-width: 1200px) 100vw, 1150px"
            width="1600"
            height="800"
            alt={d.imageAlt ?? ''}
            fetchpriority="high"
          />
          {d.photoCredit && (
            <figcaption>
              Photo by{' '}
              {d.photoCreditUrl ? <a href={creditLink(d.photoCreditUrl)}>{d.photoCredit}</a> : d.photoCredit}
              {isUnsplash && (
                <>
                  {' '}
                  on <a href={UNSPLASH_HOME}>Unsplash</a>
                </>
              )}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      hasStory && (
        <div class="recipe-story prose">
          <Content />
        </div>
      )
    }

    <div class="recipe-layout">
      <section class="ingredients" aria-labelledby="ingredients-heading">
        <h2 id="ingredients-heading">Ingredients</h2>
        <div class="scaler" data-scaler hidden>
          <span class="scaler-label" id="scaler-label">Batch size</span>
          <div class="scaler-buttons" role="group" aria-labelledby="scaler-label">
            {
              [
                ['0.5', '½×', 'Half batch'],
                ['1', '1×', 'Regular batch'],
                ['2', '2×', 'Double batch'],
                ['3', '3×', 'Triple batch'],
                ['4', '4×', 'Four times the batch'],
              ].map(([value, label, title]) => (
                <button type="button" data-scale={value} aria-pressed={value === '1' ? 'true' : 'false'} aria-label={title}>
                  {label}
                </button>
              ))
            }
          </div>
          <p class="scaler-note" data-scaler-note hidden>
            Amounts in the steps are still for 1×. A bigger or smaller batch may need a different pan size and cooking
            time.
          </p>
        </div>
        <p class="print-scale" data-print-scale hidden></p>
        {
          groupIngredients(d.ingredients).map((group) => (
            <>
              {group.section && <h3>{group.section}</h3>}
              <ul class="check-list">
                {group.items.map((line) => (
                  <li>
                    <label>
                      <input type="checkbox" />
                      <span data-ing>{line}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
        <p class="list-hint">Tap an ingredient to cross it off as you go.</p>
      </section>

      <div>
        <section class="steps" aria-labelledby="steps-heading">
          <h2 id="steps-heading">Steps</h2>
          <ol class="step-list">
            {
              d.steps.map((step, i) => (
                <li id={`step-${i + 1}`}>
                  <p>{step}</p>
                </li>
              ))
            }
          </ol>
        </section>

        {
          d.tips.length > 0 && (
            <section class="tips" aria-labelledby="tips-heading">
              <h2 id="tips-heading">Dad’s tips</h2>
              <ul>
                {d.tips.map((tip) => (
                  <li>{tip}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.adaptedFrom && (
            <p class="source">
              Adapted from <a href={d.adaptedFrom.url}>{d.adaptedFrom.name}</a>.
            </p>
          )
        }

        {
          d.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {d.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    {
      d.gallery.length > 0 && (
        <section class="recipe-gallery" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading">More photos</h2>
          <ul>
            {d.gallery.map((g) => (
              <li>
                <a href={g.src}>
                  <img
                    src={photo(g.src, 640, 480)}
                    srcset={photoSrcset(g.src, 4 / 3, [400, 640, 960])}
                    sizes="(max-width: 700px) 50vw, 300px"
                    width="640"
                    height="480"
                    alt={g.alt}
                    loading="lazy"
                  />
                </a>
                <p>{g.alt}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="wrap section related" aria-labelledby="related-heading">
        <div class="section-head">
          <h2 id="related-heading">Cook this next</h2>
        </div>
        <RecipeGrid recipes={related} />
      </section>
    )
  }
</Base>

<script>
  // @ts-ignore: plain JavaScript module shared with the Node test script
  import { scaleLine, scaleMakes } from '../../lib/scale-amounts.mjs';

  // Batch-size buttons: ½×, 1×, 2×, 3×, 4× multiply the ingredient amounts and "Makes".
  const scaler = document.querySelector<HTMLElement>('[data-scaler]');
  if (scaler) {
    const lines = [...document.querySelectorAll<HTMLElement>('[data-ing]')].map((el) => ({ el, text: el.textContent ?? '' }));
    const makes = document.querySelector<HTMLElement>('[data-makes]');
    const makesText = makes?.textContent ?? '';
    const makesBatch = document.querySelector<HTMLElement>('[data-makes-batch]');
    const note = scaler.querySelector<HTMLElement>('[data-scaler-note]');
    const printNote = document.querySelector<HTMLElement>('[data-print-scale]');
    const buttons = [...scaler.querySelectorAll<HTMLButtonElement>('[data-scale]')];

    const apply = (factor: number, label: string) => {
      for (const { el, text } of lines) el.textContent = scaleLine(text, factor);
      if (makes) makes.textContent = scaleMakes(makesText, factor) ?? makesText;
      if (makesBatch) {
        makesBatch.hidden = factor === 1;
        makesBatch.textContent = `${label} recipe`;
      }
      if (note) note.hidden = factor === 1;
      if (printNote) {
        printNote.hidden = factor === 1;
        printNote.textContent = `Amounts shown for a ${label} batch.`;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(Number(b.dataset.scale) === factor));
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(Number(b.dataset.scale), b.textContent?.trim() ?? ''));
    }
    scaler.hidden = false;
  }

  // Print button
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // "Keep screen on" uses the browser's Screen Wake Lock, where it's supported.
  const wakeButton = document.querySelector<HTMLButtonElement>('[data-wake]');
  const wakeNote = document.querySelector<HTMLElement>('[data-wake-note]');

  if (wakeButton && 'wakeLock' in navigator) {
    let lock: WakeLockSentinel | null = null;
    let wanted = false;

    const show = () => {
      wakeButton.setAttribute('aria-pressed', String(wanted));
      wakeButton.textContent = wanted ? 'Screen is staying on' : 'Keep screen on while cooking';
      if (wakeNote) wakeNote.hidden = !wanted;
    };

    const acquire = async () => {
      try {
        lock = await navigator.wakeLock.request('screen');
        lock.addEventListener('release', () => {
          lock = null;
        });
      } catch {
        wanted = false;
        show();
      }
    };

    wakeButton.hidden = false;
    wakeButton.addEventListener('click', async () => {
      wanted = !wanted;
      if (wanted) {
        await acquire();
      } else if (lock) {
        await lock.release();
        lock = null;
      }
      show();
    });

    // The browser drops the lock when you switch tabs; take it back when you return.
    document.addEventListener('visibilitychange', () => {
      if (wanted && !lock && document.visibilityState === 'visible') acquire();
    });
  }
</script>
